---
import { getCollection } from 'astro:content';
import InnerLayout from '../layouts/InnerLayout.astro';
import Icon from '../components/Icon.astro';

const all = await getCollection('services');
// Aggregator показывает 6 главных услуг — sub-tier ITS (tehno/prof) скрыты,
// они доступны со страницы /1s-its.
const services = all
  .filter((s) => s.data.slug !== '1s-its-tehno' && s.data.slug !== '1s-its-prof')
  .map((s) => s.data)
  .sort((a, b) => a.order - b.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const breadcrumb = [{ label: 'Услуги' }];

// Compact "от X ₽" для card footer.
const priceFloor = (item: (typeof services)[number]): string | null => {
  if (item.slug.startsWith('1s-its')) return 'от 9 834 ₽ / 6 мес';
  if (!item.pricing || item.pricing.tiers.length === 0) return null;
  const primary = item.pricing.tiers.find((t) => t.primary) ?? item.pricing.tiers[0];
  return primary.price;
};
---

<InnerLayout
  title="Услуги — автоматизация 1С, сайты, оборудование, Битрикс24 | T-Tech Казань"
  description="Полный список услуг T-Tech: разработка и обслуживание 1С, договор ИТС, сайты с интеграцией 1С, серверное и торговое оборудование, внедрение Битрикс24."
  heroTitle="Услуги по автоматизации бизнеса"
  heroLead="6 направлений — от разработки в 1С до Битрикс24. Внутри каждой услуги — состав, цены и кейсы по отраслям."
  heroPills={['Один подрядчик на всю 1С', '9 лет, 420 проектов', 'Казань и удалённо по РФ']}
  breadcrumb={breadcrumb}
>
  <section class="section uslugi-grid-section">
    <div class="container">
      <ul class="uslugi-grid reveal-stagger">
        {services.map((s) => {
          const floor = priceFloor(s);
          return (
            <li>
              <a href={`${base}/${s.slug}`} class="uslugi-card">
                <div class="uslugi-icon" aria-hidden="true">
                  <Icon name={s.icon} size={26} />
                </div>
                <h2 class="h3 uslugi-title">{s.title}</h2>
                <p class="uslugi-lead">{s.heroLead}</p>
                <ul class="uslugi-bullets">
                  {s.included.slice(0, 3).map((i) => (
                    <li>
                      <Icon name="check" size={14} class="bullet-check" />
                      <span>{i.title}</span>
                    </li>
                  ))}
                </ul>
                <div class="uslugi-foot">
                  {floor && (
                    <span class="uslugi-price">
                      <span class="uslugi-price-from">от</span>
                      <span class="uslugi-price-value">{floor.replace(/^от\s*/, '')}</span>
                    </span>
                  )}
                  <span class="uslugi-arrow">
                    <span>Подробнее</span>
                    <Icon name="arrow-right" size={14} />
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</InnerLayout>

<style>
  .uslugi-grid-section {
    background: var(--color-bg);
  }

  .uslugi-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    max-width: 1200px;
    margin-inline: auto;
  }

  .uslugi-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    height: 100%;
    transition: transform 250ms var(--ease-spring), box-shadow 250ms var(--ease-spring),
      border-color 250ms ease;
  }
  .uslugi-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand-500);
    box-shadow: var(--shadow-card-hover);
  }

  .uslugi-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-brand-500);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 280ms var(--ease-spring), background 220ms ease;
  }
  .uslugi-card:hover .uslugi-icon {
    background: var(--color-brand-500);
    color: #fff;
    transform: rotate(-6deg) scale(1.05);
  }

  .uslugi-title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .uslugi-lead {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-soft);
  }

  .uslugi-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }
  .uslugi-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-text-soft);
    line-height: 1.45;
  }
  .bullet-check {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .uslugi-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .uslugi-price {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .uslugi-price-from {
    font-size: 0.8125rem;
    color: var(--color-text-soft);
    font-weight: 500;
  }
  .uslugi-price-value {
    font-size: 1.0625rem;
    font-weight: 700;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .uslugi-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-500);
    margin-left: auto;
    transition: gap 200ms var(--ease-spring);
  }
  .uslugi-card:hover .uslugi-arrow {
    gap: 10px;
  }

  @media (max-width: 1024px) {
    .uslugi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .uslugi-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .uslugi-card {
      padding: var(--space-6) var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .uslugi-card,
    .uslugi-card:hover,
    .uslugi-card:hover .uslugi-icon {
      transform: none;
      transition: border-color 220ms ease;
    }
    .uslugi-arrow,
    .uslugi-card:hover .uslugi-arrow {
      transition: none;
    }
  }
</style>
