---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Страница не найдена — T-Tech"
  description="Страница, которую вы искали, не существует или была перемещена."
>
  <Header />
  <main class="not-found">
    <div class="not-found-bg" aria-hidden="true"></div>
    <div class="container not-found-inner">
      <div class="not-found-code" aria-hidden="true">404</div>
      <h1 class="h2 not-found-title">Такой страницы здесь нет</h1>
      <p class="not-found-lead">
        Возможно, страница переехала на новый адрес или была удалена. Это бывает — давайте вернёмся туда, где точно есть, что показать.
      </p>
      <div class="not-found-actions">
        <a href={`${base}/`} class="btn btn-primary">На главную</a>
        <a href={`${base}/contacts`} class="btn btn-secondary">Контакты</a>
        <a href="https://t.me/CyclesOfID" target="_blank" rel="noopener" class="not-found-tg">
          <Icon name="telegram" size={18} />
          <span>Написать в Telegram, если ищете что-то конкретное</span>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .not-found {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - var(--header-h));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-32) 0 var(--space-16);
    color: #fff;
    overflow: hidden;
  }
  .not-found-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--gradient-hero);
  }
  .not-found-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.10) 1px, transparent 1px);
    background-size: 26px 26px;
    opacity: 0.5;
  }
  .not-found-inner {
    text-align: center;
    max-width: 640px;
  }
  .not-found-code {
    font-size: clamp(5rem, 14vw, 9rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.35));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: var(--space-2);
  }
  .not-found-title {
    color: #fff;
    margin-bottom: var(--space-3);
  }
  .not-found-lead {
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 520px;
    margin-inline: auto;
  }
  .not-found-actions {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }
  .not-found-actions > .btn-primary,
  .not-found-actions > .btn-secondary {
    min-width: 200px;
  }
  .not-found-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
  }
  .not-found-actions .btn-secondary {
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.40);
  }
  .not-found-actions .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
    color: #fff;
  }
  .not-found-tg {
    flex-basis: 100%;
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9375rem;
    transition: color 200ms ease;
  }
  .not-found-tg:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
