---
import InnerLayout from '../layouts/InnerLayout.astro';
import Icon from '../components/Icon.astro';

const channels = [
  {
    icon: 'phone',
    label: 'Телефон',
    value: '+7 952 043 4277',
    href: 'tel:+79520434277',
    note: 'Пн-Пт 9:00-18:00 МСК',
    accent: 'phone',
  },
  {
    icon: 'telegram',
    label: 'Telegram',
    value: '@CyclesOfID',
    href: 'https://t.me/CyclesOfID',
    note: 'Отвечаем за 15 минут в рабочие часы',
    accent: 'tg',
    external: true,
  },
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: '+7 995 095 85 36',
    href: 'https://wa.me/79950958536',
    note: 'Удобно для пересылки скриншотов и документов',
    accent: 'wa',
    external: true,
  },
  {
    icon: 'email',
    label: 'Email',
    value: 'ttech.kzn.it@gmail.com',
    href: 'mailto:ttech.kzn.it@gmail.com',
    note: 'Для договоров, ТЗ, актов и счетов',
    accent: 'email',
  },
];

const office = {
  city: 'Казань',
  street: 'ул. Дубравная, 43а',
  hours: 'Пн-Пт, 9:00-18:00 МСК',
  yandexEmbed:
    'https://yandex.ru/map-widget/v1/?ll=49.150%2C55.821&mode=search&%3D%3D&sll=49.150000%2C55.821000&sspn=0.05%2C0.02&text=%D0%9A%D0%B0%D0%B7%D0%B0%D0%BD%D1%8C%2C%20%D1%83%D0%BB.%20%D0%94%D1%83%D0%B1%D1%80%D0%B0%D0%B2%D0%BD%D0%B0%D1%8F%2C%2043%D0%B0&z=16',
};

const breadcrumb = [{ label: 'Контакты' }];
---

<InnerLayout
  title="Контакты T-Tech — Казань, ул. Дубравная 43а"
  description="Связаться с T-Tech: телефон +7 952 043 4277, Telegram @CyclesOfID, WhatsApp +7 995 095 85 36, email ttech.kzn.it@gmail.com. Казань, Дубравная 43а. Пн-Пт 9:00-18:00 МСК."
  heroTitle="Свяжитесь с нами напрямую"
  heroLead="Никаких форм и менеджеров на колл-центре. Пишете в любой удобный канал — отвечает специалист, который ведёт ваш проект."
  breadcrumb={breadcrumb}
>
  <section class="section channels-section">
    <div class="container">
      <div class="channels-grid">
        {channels.map((c) => (
          <a
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener' : undefined}
            class={`channel-card channel-${c.accent}`}
          >
            <div class="channel-icon" aria-hidden="true">
              <Icon name={c.icon} size={24} />
            </div>
            <div class="channel-body">
              <div class="channel-label">{c.label}</div>
              <div class="channel-value">{c.value}</div>
              <div class="channel-note">{c.note}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section office-section">
    <div class="container">
      <div class="office-grid">
        <div class="office-info">
          <span class="eyebrow">Офис</span>
          <h2 class="h2 office-title">{office.city}, {office.street}</h2>
          <ul class="office-meta">
            <li>
              <span class="meta-icon" aria-hidden="true">🕒</span>
              <span>{office.hours}</span>
            </li>
            <li>
              <span class="meta-icon" aria-hidden="true">📍</span>
              <span>5 минут пешком от ст. метро «Дубравная»</span>
            </li>
            <li>
              <span class="meta-icon" aria-hidden="true">🚗</span>
              <span>Бесплатная парковка во дворе</span>
            </li>
          </ul>
          <p class="office-note">
            Если хотите встретиться лично — предупредите за день, чтобы мы освободили время и подготовили ваш проект к разговору.
          </p>
        </div>

        <div class="office-map" id="office-map">
          <button
            type="button"
            class="map-placeholder"
            id="map-load-btn"
            data-src={office.yandexEmbed}
            aria-label="Загрузить карту Яндекс. Внимание: загрузка карты создаёт куки на стороне Яндекса."
          >
            <span class="map-icon" aria-hidden="true">🗺</span>
            <span class="map-cta-title">Карта: {office.city}, {office.street}</span>
            <span class="map-cta-note">
              Кликните, чтобы загрузить карту Яндекс. Карта подгружается отдельно — это создаёт куки Яндекса.
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>

<style>
  /* Channels grid: 4 wide on desktop, 2 on tablet, 1 on mobile */
  .channels-section {
    padding-top: var(--space-20);
    padding-bottom: var(--space-12);
  }
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }
  @media (max-width: 1024px) {
    .channels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .channels-grid {
      grid-template-columns: 1fr;
    }
  }

  .channel-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    transition: transform 250ms var(--ease-spring), box-shadow 250ms var(--ease-spring),
      border-color 250ms ease;
    color: var(--color-text);
    height: 100%;
  }
  .channel-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-brand-500);
  }

  .channel-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }
  .channel-phone .channel-icon { background: var(--color-brand-500); }
  .channel-tg .channel-icon { background: #229ED9; }
  .channel-wa .channel-icon { background: #25D366; }
  .channel-email .channel-icon {
    background: rgba(37, 99, 235, 0.10);
    color: var(--color-brand-500);
  }

  .channel-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }
  .channel-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    word-break: break-word;
  }
  .channel-note {
    margin-top: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-soft);
    line-height: 1.5;
  }

  /* Office section: info + map */
  .office-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
    background: var(--color-bg-alt);
  }
  .office-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-12);
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .office-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .office-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .office-title {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    margin-top: var(--space-2);
  }
  .office-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .office-meta li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 1rem;
    color: var(--color-text-soft);
    line-height: 1.55;
  }
  .meta-icon {
    flex-shrink: 0;
    font-size: 1.125rem;
  }
  .office-note {
    margin-top: var(--space-4);
    font-size: 0.9375rem;
    color: var(--color-text-soft);
    line-height: 1.6;
    padding: var(--space-4);
    border-left: 3px solid var(--color-brand-500);
    background: rgba(37, 99, 235, 0.04);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .office-map {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 360px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    background:
      linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(99, 91, 255, 0.06)),
      var(--color-bg-alt);
  }
  .office-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6);
    background: transparent;
    cursor: pointer;
    text-align: center;
    transition: background-color 220ms ease;
  }
  .map-placeholder:hover {
    background: rgba(37, 99, 235, 0.05);
  }
  .map-icon {
    font-size: 2.5rem;
    line-height: 1;
  }
  .map-cta-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-brand-500);
    text-underline-offset: 4px;
  }
  .map-cta-note {
    font-size: 0.875rem;
    color: var(--color-text-soft);
    max-width: 360px;
    line-height: 1.5;
  }
</style>

<script>
  const btn = document.getElementById('map-load-btn');
  const wrap = document.getElementById('office-map');
  if (btn && wrap) {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src');
      if (!src) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'Карта: Казань, ул. Дубравная 43а';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allow = 'geolocation';
      btn.remove();
      wrap.appendChild(iframe);
    });
  }
</script>
