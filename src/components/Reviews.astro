---
// PLACEHOLDER TESTIMONIALS — клиент подтверждает к session 11.
// Структура: per-industry avatar (matches Cases badge colors) + name/role/company + B2B past-tense pain → present-tense result.
// Связь Reviews ↔ Cases: ЖКХ #01, Аптеки #07, Памятники #08 (см. Cases.astro).
const reviews = [
  {
    initials: 'ОК',
    name: 'Ольга К.',
    role: 'Главный бухгалтер',
    company: 'Управляющая компания, 240 МКД, Казань',
    quote:
      'До перехода на 1С:ЖКХ мы закрывали месяц вручную: сводили начисления по каждому дому в Excel, сверяли с ГИС ЖКХ отдельно — три дня работы двух человек. Сейчас месячный цикл закрываем за один день, выгрузка в ГИС уходит автоматически.',
    avatarBg: '#1D4ED8', // matches Cases.astro #01 ЖКХ
    industry: 'ЖКХ',
  },
  {
    initials: 'РА',
    name: 'Расул А.',
    role: 'Руководитель ИТ',
    company: 'Аптечная сеть, 35 точек, Татарстан',
    quote:
      'Каждая точка вела товарный учёт в своей базе, маркировку МДЛП обрабатывали через отдельный сервис — при расхождениях искали виноватых часами. После объединения на 1С:Управление аптечной сетью остатки по 35 точкам видны в одном окне, маркировка проходит без ручных сверок.',
    avatarBg: '#0E7490', // matches Cases.astro #07 Аптеки
    industry: 'Аптечная сеть',
  },
  {
    initials: 'ИМ',
    name: 'Ильнур М.',
    role: 'Владелец производства',
    company: 'Изделия из гранита и мрамора, 1000+ изделий/год, Казань',
    quote:
      'Раньше каждый заказ — отдельная смета в Excel и карточка в блокноте мастера. При 80–100 заказах в месяц регулярно теряли детали: неправильный размер уходил в порезку. Сейчас заказ от замера до отгрузки идёт через одну карточку в 1С — за полгода ни одного возврата по нашей вине.',
    avatarBg: '#334155', // matches Cases.astro #08 Памятники
    industry: 'Производство',
  },
];
---

<section class="section reviews" id="reviews">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">Отзывы</span>
      <h2 class="h2">Что говорят клиенты</h2>
      <p class="lead">
        Сокращённые цитаты из рекомендательных писем — полный текст с печатью пришлём по запросу.
      </p>
    </header>

    <ul class="reviews-grid reveal-stagger">
      {reviews.map((r, i) => (
        <li class="review-card" style={`--i: ${i};`}>
          <header class="review-head">
            <div
              class="review-avatar"
              role="img"
              aria-label={`Аватар ${r.name}`}
              style={`--avatar-bg: ${r.avatarBg};`}
            >
              {r.initials}
            </div>
            <div class="review-meta">
              <div class="review-name">{r.name}</div>
              <div class="review-role">{r.role}</div>
              <div class="review-company">{r.company}</div>
            </div>
          </header>

          <blockquote class="review-quote">{r.quote}</blockquote>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews {
    background: var(--color-bg-alt);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .review-card {
    position: relative;
    isolation: isolate;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    transition: transform 250ms var(--ease-spring), box-shadow 250ms var(--ease-spring),
      border-color 250ms ease;
    overflow: hidden;
  }

  /* Decorative quote-mark (Georgia serif), opacity-driven hover.
     Differentiates from Services border-glow and Cases spotlight. */
  .review-card::before {
    content: '\201C';
    position: absolute;
    top: -1.25rem;
    left: var(--space-5);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 6rem;
    line-height: 1;
    color: var(--color-brand-500);
    opacity: 0.12;
    transform: translateY(4px);
    transition: opacity 300ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .review-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    position: relative;
    z-index: 1;
  }

  .review-avatar {
    --avatar-size: 48px;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    background-color: var(--avatar-bg, var(--color-brand-500));
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: calc(var(--avatar-size) * 0.42);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    user-select: none;
    flex-shrink: 0;
  }

  .review-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .review-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }
  .review-role {
    font-size: 0.8125rem;
    color: var(--color-brand-500);
    font-weight: 500;
    line-height: 1.3;
  }
  .review-company {
    font-size: 0.75rem;
    color: var(--color-text-soft);
    line-height: 1.4;
  }

  .review-quote {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
    flex-grow: 1;
    position: relative;
    z-index: 1;
  }

  /* Desktop hover — quote-mark animation + card lift. Gated to avoid touch. */
  @media (hover: hover) and (pointer: fine) {
    .review-card:hover,
    .review-card:focus-within {
      transform: translateY(-4px);
      border-color: var(--color-brand-500);
      box-shadow: var(--shadow-card-hover);
    }
    .review-card:hover::before,
    .review-card:focus-within::before {
      opacity: 0.28;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .review-card,
    .review-card::before {
      transition: opacity 200ms linear;
    }
    .review-card:hover,
    .review-card:focus-within {
      transform: none;
    }
    .review-card:hover::before,
    .review-card:focus-within::before {
      transform: none;
    }
  }

  @media (max-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .reviews-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .review-card {
      padding: var(--space-6) var(--space-5) var(--space-5);
    }
    .review-card::before {
      font-size: 4.5rem;
      top: -0.75rem;
    }
  }
</style>
