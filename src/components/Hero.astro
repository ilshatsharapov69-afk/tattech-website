---
import Icon from './Icon.astro';
---

<section class="hero">
  <div class="bg" aria-hidden="true">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="dots"></div>
  </div>

  <div class="container hero-inner">
    <span class="pill hero-pill">
      <Icon name="star" size={14} />
      <span>Официальный партнёр 1С • С 2016 года</span>
    </span>

    <h1 class="h1 hero-title">
      Автоматизация бизнеса <br class="d-desk" />
      <span class="text-gradient">на 1С</span> — без хаоса,<br class="d-desk" />
      в срок, под ключ.
    </h1>

    <p class="lead hero-sub">
      Внедряем 1С под&nbsp;ключ, поддерживаем и&nbsp;обучаем команду. <strong>300+ компаний</strong> закрывают отчётность вовремя, считают зарплату без&nbsp;ошибок и&nbsp;спокойно проходят проверки.
    </p>

    <div class="hero-cta">
      <a
        href="https://t.me/CyclesOfID"
        target="_blank"
        rel="noopener"
        class="btn btn-primary btn-lg"
        data-magnetic
      >
        <Icon name="telegram" size={18} />
        <span>Написать в Telegram</span>
      </a>
      <a href="#cases" class="btn btn-secondary btn-lg">
        <span>Посмотреть кейсы</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="hero-trust">
      <div class="trust-item">
        <Icon name="check" size={18} class="trust-icon" />
        <span>Этапы и&nbsp;сроки фиксируем в&nbsp;договоре</span>
      </div>
      <div class="trust-item">
        <Icon name="check" size={18} class="trust-icon" />
        <span>Поддержка 5/2 после запуска</span>
      </div>
      <div class="trust-item">
        <Icon name="check" size={18} class="trust-icon" />
        <span>Бесплатная консультация, без&nbsp;обязательств</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h) + var(--space-12));
    padding-bottom: var(--space-24);
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 55%, #635BFF 100%);
    color: #fff;
  }
  /* Fade Hero's bottom edge so it dissolves into Stats's blue-tinted gradient */
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(30, 58, 138, 0) 0%,
      rgba(30, 58, 138, 0.35) 100%
    );
    z-index: 0;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    animation: float 12s ease-in-out infinite alternate;
  }
  .glow-1 {
    top: -10%;
    left: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.22), transparent 65%);
  }
  .glow-2 {
    bottom: -20%;
    right: -10%;
    width: 55vw;
    height: 55vw;
    max-width: 680px;
    max-height: 680px;
    background: radial-gradient(circle at 70% 70%, rgba(199, 210, 254, 0.28), transparent 65%);
    animation-delay: -6s;
  }
  @keyframes float {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(20px, -30px) scale(1.05); }
  }

  /* Dots react to cursor: spotlight mask follows --mx/--my (set by mouse-glow.ts).
     Default 50% 50% means a soft center halo when cursor is not over Hero. */
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.32) 1.5px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: radial-gradient(
      circle 380px at var(--mx, 50%) var(--my, 50%),
      black 0%,
      rgba(0, 0, 0, 0.18) 70%
    );
    -webkit-mask-image: radial-gradient(
      circle 380px at var(--mx, 50%) var(--my, 50%),
      black 0%,
      rgba(0, 0, 0, 0.18) 70%
    );
  }

  .hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .hero-pill {
    animation: fadeUp 800ms var(--ease-spring) both;
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero :global(.text-gradient) {
    background: linear-gradient(135deg, #BFDBFE 0%, #DDD6FE 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-title {
    max-width: 980px;
    animation: fadeUpBlur 900ms var(--ease-spring) both;
    animation-delay: 80ms;
  }

  .hero-sub {
    max-width: 620px;
    margin-top: 0;
    color: rgba(255, 255, 255, 0.88);
    animation: fadeUp 800ms var(--ease-spring) both;
    animation-delay: 220ms;
  }

  .hero-sub strong {
    color: #fff;
    font-weight: 700;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-4);
    animation: fadeUp 800ms var(--ease-spring) both;
    animation-delay: 340ms;
  }

  .btn-lg {
    padding: 18px 28px;
    font-size: 1rem;
  }

  .hero-trust {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    width: 100%;
    max-width: 720px;
    animation: fadeUp 800ms var(--ease-spring) both;
    animation-delay: 540ms;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.88);
    font-weight: 500;
  }
  .trust-icon {
    color: #6EE7B7;
  }

  .hero :global(.btn-primary) {
    background: #F59E0B;
    color: #fff;
    box-shadow: 0 8px 22px rgba(245, 158, 11, 0.45);
    position: relative;
  }
  .hero :global(.btn-primary)::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.45);
    animation: tt-pulse-ring 2.4s cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
  }
  .hero :global(.btn-primary:hover) {
    box-shadow: 0 12px 32px rgba(245, 158, 11, 0.55);
  }
  .hero :global(.btn-primary:hover)::after {
    animation-play-state: paused;
  }
  @keyframes tt-pulse-ring {
    0%   { box-shadow: 0 0 0 0   rgba(245, 158, 11, 0.45); }
    70%  { box-shadow: 0 0 0 12px rgba(245, 158, 11, 0); }
    100% { box-shadow: 0 0 0 0   rgba(245, 158, 11, 0); }
  }

  .hero :global(.btn-secondary) {
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .hero :global(.btn-secondary:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
    color: #fff;
    transform: translateY(-2px);
  }

  .d-desk {
    display: inline;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeUpBlur {
    from { opacity: 0; transform: translateY(20px); filter: blur(8px); }
    to   { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100vh;
      padding-top: calc(var(--header-h) + var(--space-8));
    }
    .d-desk {
      display: none;
    }
    .hero-title {
      font-size: clamp(1.875rem, 7vw, 2.5rem);
    }
    .hero-cta {
      flex-direction: column;
      width: 100%;
    }
    .hero-cta .btn {
      width: 100%;
    }
    .hero-trust {
      gap: var(--space-3);
      flex-direction: column;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
    .hero-pill,
    .hero-title,
    .hero-sub,
    .hero-cta,
    .hero-trust {
      animation: none;
    }
  }
</style>
