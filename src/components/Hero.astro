---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero">
  <div class="bg" aria-hidden="true">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="dots"></div>
  </div>

  <div class="container hero-inner">
    <span class="pill hero-pill">
      <Icon name="star" size={14} />
      <span>Официальный партнёр 1С • С 2016 года</span>
    </span>

    <h1 class="h1 hero-title">
      Автоматизация бизнеса <br class="d-desk" />
      на <span class="hero-1c-mark">
        <img src={`${base}/images/services/1c-logo.svg`} alt="1С" width="200" height="98" />
      </span> — без хаоса,<br class="d-desk" />
      в срок, под ключ.
    </h1>

    <p class="lead hero-sub">
      Внедряем 1С под&nbsp;ключ, поддерживаем и&nbsp;обучаем команду. <strong>300+ компаний</strong> закрывают отчётность вовремя, считают зарплату без&nbsp;ошибок и&nbsp;спокойно проходят проверки.
    </p>

    <div class="hero-cta">
      <a
        href="https://t.me/CyclesOfID"
        target="_blank"
        rel="noopener"
        class="btn btn-primary btn-lg"
        data-magnetic
      >
        <Icon name="telegram" size={18} />
        <span>Написать в Telegram</span>
      </a>
      <a href="#cases" class="btn btn-secondary btn-lg">
        <span>Посмотреть кейсы</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="hero-trust">
      <div class="trust-item trust-item--left">
        <Icon name="check" size={18} class="trust-icon" />
        <span>Этапы и&nbsp;сроки фиксируем в&nbsp;договоре</span>
      </div>
      <div class="trust-item trust-item--up">
        <Icon name="check" size={18} class="trust-icon" />
        <span>Поддержка 5/2 после запуска</span>
      </div>
      <div class="trust-item trust-item--right trust-item--free">
        <Icon name="check" size={18} class="trust-icon" />
        <span>Бесплатная консультация, без&nbsp;обязательств</span>
      </div>
    </div>

    <a href="#services" class="hero-scroll" aria-label="Прокрутить вниз">
      <span class="hero-scroll-chevron"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h) + var(--space-12));
    padding-bottom: var(--space-24);
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 55%, #635BFF 100%);
    color: #fff;
  }
  /* Fade Hero's bottom edge so it dissolves into Stats's blue-tinted gradient */
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(30, 58, 138, 0) 0%,
      rgba(30, 58, 138, 0.35) 100%
    );
    z-index: 0;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    animation: float 12s ease-in-out infinite alternate;
  }
  .glow-1 {
    top: -10%;
    left: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.22), transparent 65%);
  }
  .glow-2 {
    bottom: -20%;
    right: -10%;
    width: 55vw;
    height: 55vw;
    max-width: 680px;
    max-height: 680px;
    background: radial-gradient(circle at 70% 70%, rgba(199, 210, 254, 0.28), transparent 65%);
    animation-delay: -6s;
  }
  @keyframes float {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(20px, -30px) scale(1.05); }
  }

  /* Dots react to cursor: spotlight mask follows --mx/--my (set by mouse-glow.ts).
     Default 50% 50% means a soft center halo when cursor is not over Hero. */
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.32) 1.5px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: radial-gradient(
      circle 380px at var(--mx, 50%) var(--my, 50%),
      black 0%,
      rgba(0, 0, 0, 0.18) 70%
    );
    -webkit-mask-image: radial-gradient(
      circle 380px at var(--mx, 50%) var(--my, 50%),
      black 0%,
      rgba(0, 0, 0, 0.18) 70%
    );
  }

  .hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .hero-pill {
    animation: fadeUp 800ms var(--ease-spring) both;
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero :global(.text-gradient) {
    background: linear-gradient(135deg, #BFDBFE 0%, #DDD6FE 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Inline 1C logo replacing the text "1С" in H1 — naked red SVG, no chrome */
  .hero-1c-mark {
    display: inline-flex;
    align-items: center;
    vertical-align: -0.08em;
    margin: 0 0.06em;
    line-height: 1;
    transform-origin: center;
  }
  .hero-1c-mark img {
    display: block;
    height: 0.78em;
    width: auto;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.35));
  }

  .hero-title {
    max-width: 980px;
    animation: fadeUpBlur 900ms var(--ease-spring) both;
    animation-delay: 80ms;
  }

  .hero-sub {
    max-width: 620px;
    margin-top: 0;
    color: rgba(255, 255, 255, 0.88);
    animation: fadeUp 800ms var(--ease-spring) both;
    animation-delay: 220ms;
  }

  .hero-sub strong {
    color: #fff;
    font-weight: 700;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-4);
    animation: fadeUp 800ms var(--ease-spring) both;
    animation-delay: 340ms;
  }

  .btn-lg {
    padding: 18px 28px;
    font-size: 1rem;
  }

  .hero-trust {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    width: 100%;
    max-width: 720px;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.88);
    font-weight: 500;
    opacity: 0;
  }
  .trust-item--left  { animation: trustInLeft  700ms var(--ease-spring) 540ms both; }
  .trust-item--up    { animation: trustInUp    700ms var(--ease-spring) 720ms both; }
  .trust-item--right { animation: trustInRight 700ms var(--ease-spring) 900ms both; }
  .trust-icon {
    color: #6EE7B7;
  }

  .trust-item--free {
    color: #86EFAC;
    font-weight: 600;
    text-shadow: 0 0 18px rgba(110, 231, 183, 0.35);
  }
  .trust-item--free :global(.trust-icon) {
    color: #6EE7B7;
    filter: drop-shadow(0 0 6px rgba(110, 231, 183, 0.7));
    animation: freePulse 2.6s ease-in-out 1.6s infinite;
  }

  @keyframes trustInLeft {
    from { opacity: 0; transform: translateX(-18px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes trustInUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes trustInRight {
    from { opacity: 0; transform: translateX(18px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes freePulse {
    0%, 100% { transform: scale(1);    filter: drop-shadow(0 0 6px rgba(110, 231, 183, 0.6)); }
    50%      { transform: scale(1.18); filter: drop-shadow(0 0 12px rgba(110, 231, 183, 1)); }
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    opacity: 0;
    animation: fadeUp 800ms var(--ease-spring) 1100ms both;
    transition: opacity 200ms ease;
  }
  .hero-scroll:hover { opacity: 1 !important; }
  .hero-scroll-chevron {
    display: block;
    width: 14px;
    height: 14px;
    border-right: 2px solid rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(255, 255, 255, 0.7);
    transform: rotate(45deg);
    margin-top: -4px;
    animation: scrollBounce 1.8s cubic-bezier(0.45, 0, 0.55, 1) 1500ms infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { transform: rotate(45deg) translate(0, 0);    opacity: 0.55; }
    50%      { transform: rotate(45deg) translate(4px, 4px); opacity: 1; }
  }

  .hero :global(.btn-primary) {
    background: #F59E0B;
    color: #fff;
    box-shadow: 0 8px 22px rgba(245, 158, 11, 0.45);
    position: relative;
  }
  .hero :global(.btn-primary)::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.45);
    animation: tt-pulse-ring 2.4s cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
  }
  .hero :global(.btn-primary:hover) {
    box-shadow: 0 12px 32px rgba(245, 158, 11, 0.55);
  }
  .hero :global(.btn-primary:hover)::after {
    animation-play-state: paused;
  }
  @keyframes tt-pulse-ring {
    0%   { box-shadow: 0 0 0 0   rgba(245, 158, 11, 0.45); }
    70%  { box-shadow: 0 0 0 12px rgba(245, 158, 11, 0); }
    100% { box-shadow: 0 0 0 0   rgba(245, 158, 11, 0); }
  }

  .hero :global(.btn-secondary) {
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .hero :global(.btn-secondary:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
    color: #fff;
    transform: translateY(-2px);
  }

  .d-desk {
    display: inline;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeUpBlur {
    from { opacity: 0; transform: translateY(20px); filter: blur(8px); }
    to   { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100vh;
      padding-top: calc(var(--header-h) + var(--space-8));
    }
    .d-desk {
      display: none;
    }
    .hero-title {
      font-size: clamp(1.875rem, 7vw, 2.5rem);
    }
    .hero-cta {
      flex-direction: column;
      width: 100%;
    }
    .hero-cta .btn {
      width: 100%;
    }
    .hero-trust {
      gap: var(--space-3);
      flex-direction: column;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
    .hero-pill,
    .hero-title,
    .hero-sub,
    .hero-cta,
    .hero-trust,
    .trust-item,
    .trust-item--free :global(.trust-icon),
    .hero-scroll,
    .hero-scroll-chevron,
    .hero-1c-mark {
      animation: none;
    }
    .trust-item { opacity: 1; }
    .hero-scroll { opacity: 0.7; }
  }
</style>
