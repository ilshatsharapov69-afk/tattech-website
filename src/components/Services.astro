---
import Icon from './Icon.astro';

const services = [
  {
    icon: 'code',
    title: '1С Разработка',
    description: 'Прикладные решения и интеграции под ваши процессы.',
    bullets: ['Типовые конфигурации и доработки', 'Разработка с нуля', 'Интеграция с CRM, банком, маркетплейсами'],
    price: null,
    tgMsg: 'Здравствуйте! Хочу обсудить разработку или доработку 1С',
  },
  {
    icon: 'wrench',
    title: 'Обслуживание 1С',
    description: 'Техподдержка, обновления и бэкапы — без простоев.',
    bullets: ['Обновления каждый месяц', 'Регламентные резервные копии', 'Поддержка по телефону и удалённо'],
    price: '4 990 ₽/мес',
    tgMsg: 'Здравствуйте! Хочу обсудить обслуживание 1С',
  },
  {
    icon: 'globe',
    title: 'Разработка сайтов',
    description: 'WordPress, Tilda и лендинги с интеграцией с 1С.',
    bullets: ['Каталог и остатки из 1С', 'Онлайн-оплата и заявки в CRM', 'SEO-оптимизация под Яндекс'],
    price: '50 000 ₽',
    tgMsg: 'Здравствуйте! Хочу обсудить разработку сайта',
  },
  {
    icon: 'shield',
    title: '1С:ИТС',
    description: 'Официальные лицензии и ИТ-сопровождение по подписке.',
    bullets: ['Активация за день', 'Автообновления конфигураций', 'Линия консультаций 1С'],
    price: '16 200 ₽/год',
    tgMsg: 'Здравствуйте! Хочу оформить 1С:ИТС',
  },
  {
    icon: 'server',
    title: 'Подбор оборудования',
    description: 'Серверы, кассы и сканеры — установка под ключ.',
    bullets: ['Подбор под бюджет и задачу', 'Поставка от партнёров', 'Монтаж и настройка'],
    price: null,
    tgMsg: 'Здравствуйте! Нужен подбор оборудования',
  },
  {
    icon: 'chart',
    title: 'Битрикс-24',
    description: 'CRM, портал и обмен с 1С — настраиваем под ваш отдел.',
    bullets: ['Воронки продаж и роботы', 'Телефония и почта', 'Двусторонний обмен с 1С'],
    price: '25 000 ₽',
    tgMsg: 'Здравствуйте! Хочу обсудить настройку Битрикс-24',
  },
];

const tgUrl = (msg: string) => `https://t.me/CyclesOfID?text=${encodeURIComponent(msg)}`;
---

<section class="section services has-glow" id="services">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">Услуги</span>
      <h2 class="h2">Что мы делаем</h2>
      <p class="lead">
        От разработки 1С до интеграций с Битрикс-24 — закрываем весь цикл автоматизации.
      </p>
    </header>

    <ul class="grid reveal-stagger">
      {services.map((service) => (
        <li class="card service-card">
          <div class="icon-wrap">
            <Icon name={service.icon} size={28} />
          </div>
          <h3 class="h3">{service.title}</h3>
          <p class="text-soft service-desc">{service.description}</p>
          <ul class="service-bullets">
            {service.bullets.map((b) => (
              <li>
                <Icon name="check" size={14} class="bullet-check" />
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <div class="service-reveal">
            {service.price && (
              <div class="service-price">
                <span class="price-from">от</span>
                <span class="price-value text-gradient">{service.price}</span>
              </div>
            )}
            <a href={tgUrl(service.tgMsg)} target="_blank" rel="noopener" class="service-cta">
              <Icon name="telegram" size={16} />
              <span>Обсудить в Telegram</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // 3D tilt on pointermove — desktop only, respects prefers-reduced-motion.
  // Card transform driven by --rx / --ry CSS variables.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const MAX_TILT = 10; // degrees

  if (!reduced && canHover) {
    document.querySelectorAll<HTMLElement>('.services .service-card').forEach((card) => {
      card.addEventListener(
        'pointermove',
        (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          card.style.setProperty('--rx', `${(0.5 - y) * MAX_TILT}deg`);
          card.style.setProperty('--ry', `${(x - 0.5) * MAX_TILT}deg`);
        },
        { passive: true }
      );
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--rx');
        card.style.removeProperty('--ry');
      });
    });
  }
</script>

<style>
  /* Tighten Stats → Services gap (override .section padding-block) */
  .services {
    padding-top: var(--space-16);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .service-card {
    gap: var(--space-4);
    position: relative;
    /* Override .card hover translateY — 3D tilt handles the lift via translateZ */
    transform: perspective(1000px)
      rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 320ms var(--ease-spring),
      box-shadow 250ms var(--ease-spring),
      border-color 250ms ease;
  }

  /* Override the .card:hover translateY (it conflicts with 3D rotate) */
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      transform: perspective(1000px)
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        translateZ(8px);
    }
  }

  .icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-500);
    transition: transform 280ms var(--ease-spring), background 220ms ease,
      border-color 220ms ease;
  }
  .service-card:hover .icon-wrap {
    background: rgba(37, 99, 235, 0.08);
    border-color: var(--color-brand-500);
    transform: rotate(-6deg) scale(1.05);
  }

  .service-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .service-bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    flex-grow: 1;
  }
  .service-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-text-soft);
    line-height: 1.45;
  }
  .bullet-check {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* Reveal block: price + TG CTA. Always reserves space (height stable) — fades in on hover. */
  .service-reveal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 240ms ease, transform 320ms var(--ease-spring);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover .service-reveal,
    .service-card:focus-within .service-reveal {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  /* On touch devices reveal is permanently visible — no hover possible */
  @media (hover: none), (pointer: coarse) {
    .service-reveal {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  .service-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    flex-shrink: 0;
  }
  .price-from {
    font-size: 0.8125rem;
    color: var(--color-text-soft);
    font-weight: 500;
  }
  .price-value {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 14px;
    background: var(--color-brand-500);
    color: #fff;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
    transition: transform 200ms var(--ease-spring),
      background-color 200ms ease,
      box-shadow 200ms ease;
    margin-left: auto;
  }
  .service-cta:hover {
    background: var(--color-brand-600);
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.36);
  }

  /* ===== Border-glow on hover (animated conic-gradient + @property --bg-angle).
     Scoped to (hover: hover) so touch browsers don't parse/composite the
     conic-gradient layer. ===== */
  @property --bg-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes service-bg-spin {
    to { --bg-angle: 360deg; }
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card {
      isolation: isolate;
    }
    .service-card::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      background:
        linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
        conic-gradient(
          from var(--bg-angle),
          var(--color-brand-500),
          var(--color-brand-purple),
          var(--color-brand-500)
        ) border-box;
      border: 2px solid transparent;
      z-index: -1;
      pointer-events: none;
      opacity: 0;
      animation: service-bg-spin 5s linear infinite paused;
      transition: opacity 320ms ease;
    }
    .service-card:hover::after,
    .service-card:focus-within::after {
      opacity: 1;
      animation-play-state: running;
    }
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services {
      padding-top: var(--space-12);
    }
    /* On smaller cards stack price above CTA — keeps button full-width */
    .service-reveal {
      flex-direction: column;
      align-items: stretch;
    }
    .service-cta {
      margin-left: 0;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transform: none !important;
      transition: none;
    }
    .service-reveal {
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
      transition: none;
    }
  }
</style>
