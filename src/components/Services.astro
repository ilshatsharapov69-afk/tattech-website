---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const watermarkSrc: Record<string, string> = {
  '1c':  `${base}/images/services/1c-logo.svg`,
  'b24': `${base}/images/services/bitrix24-logo.svg`,
  'web': `${base}/images/services/web-code.jpg`,
  'pos': `${base}/images/services/pos-terminal.jpg`,
};

const services = [
  {
    icon: 'code',
    title: '1С Разработка',
    description: 'Прикладные решения и интеграции под ваши процессы.',
    bullets: ['Типовые конфигурации и доработки', 'Разработка с нуля', 'Интеграция с CRM, банком, маркетплейсами'],
    price: null,
    tgMsg: 'Здравствуйте! Хочу обсудить разработку или доработку 1С',
    watermark: '1c',
  },
  {
    icon: 'wrench',
    title: 'Обслуживание 1С',
    description: 'Техподдержка, обновления и бэкапы — без простоев.',
    bullets: ['Обновления каждый месяц', 'Регламентные резервные копии', 'Поддержка по телефону и удалённо'],
    price: '4 990 ₽/мес',
    tgMsg: 'Здравствуйте! Хочу обсудить обслуживание 1С',
    watermark: '1c',
  },
  {
    icon: 'globe',
    title: 'Разработка сайтов',
    description: 'WordPress, Tilda и лендинги с интеграцией с 1С.',
    bullets: ['Каталог и остатки из 1С', 'Онлайн-оплата и заявки в CRM', 'SEO-оптимизация под Яндекс'],
    price: '50 000 ₽',
    tgMsg: 'Здравствуйте! Хочу обсудить разработку сайта',
    watermark: 'web',
  },
  {
    icon: 'shield',
    title: '1С:ИТС',
    description: 'Официальные лицензии и ИТ-сопровождение по подписке.',
    bullets: ['Активация за день', 'Автообновления конфигураций', 'Линия консультаций 1С'],
    price: '16 200 ₽/год',
    tgMsg: 'Здравствуйте! Хочу оформить 1С:ИТС',
    watermark: '1c',
  },
  {
    icon: 'server',
    title: 'Подбор оборудования',
    description: 'Серверы, кассы и сканеры — установка под ключ.',
    bullets: ['Подбор под бюджет и задачу', 'Поставка от партнёров', 'Монтаж и настройка'],
    price: null,
    tgMsg: 'Здравствуйте! Нужен подбор оборудования',
    watermark: 'pos',
  },
  {
    icon: 'chart',
    title: 'Битрикс-24',
    description: 'CRM, портал и обмен с 1С — настраиваем под ваш отдел.',
    bullets: ['Воронки продаж и роботы', 'Телефония и почта', 'Двусторонний обмен с 1С'],
    price: '25 000 ₽',
    tgMsg: 'Здравствуйте! Хочу обсудить настройку Битрикс-24',
    watermark: 'b24',
  },
];

const tgUrl = (msg: string) => `https://t.me/CyclesOfID?text=${encodeURIComponent(msg)}`;
---

<section class="section services has-glow" id="services">
  <div class="container">
    <header class="section-head services-head reveal">
      <span class="eyebrow services-eyebrow">Услуги</span>
      <h2 class="h2 services-title">
        Один подрядчик на&nbsp;всю <span class="text-gradient title-accent">1С</span>
      </h2>
      <p class="lead services-lead">
        <span class="kw kw-1">Лицензии</span>,
        <span class="kw kw-2">разработка</span>,
        <span class="kw kw-3">поддержка</span>,
        <span class="kw kw-4">оборудование</span>,
        <span class="kw kw-5">Битрикс</span>
        — без сборки команды из подрядчиков под каждую задачу.
      </p>
    </header>

    <ul class="grid reveal-stagger">
      {services.map((service) => (
        <li class="card service-card">
          <span class={`card-watermark wm-${service.watermark}`} aria-hidden="true">
            <img
              src={watermarkSrc[service.watermark]}
              alt=""
              loading="lazy"
              decoding="async"
              class="watermark-img"
            />
          </span>
          <div class="icon-wrap">
            <Icon name={service.icon} size={28} />
          </div>
          <h3 class="h3">{service.title}</h3>
          <p class="text-soft service-desc">{service.description}</p>
          <ul class="service-bullets">
            {service.bullets.map((b) => (
              <li>
                <Icon name="check" size={14} class="bullet-check" />
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <div class="service-reveal">
            {service.price && (
              <div class="service-price">
                <span class="price-from">от</span>
                <span class="price-value text-gradient">{service.price}</span>
              </div>
            )}
            <a href={tgUrl(service.tgMsg)} target="_blank" rel="noopener" class="service-cta">
              <Icon name="telegram" size={16} />
              <span>Обсудить в Telegram</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // 3D tilt on pointermove — desktop only, respects prefers-reduced-motion.
  // Card transform driven by --rx / --ry CSS variables.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const MAX_TILT = 10; // degrees

  if (!reduced && canHover) {
    document.querySelectorAll<HTMLElement>('.services .service-card').forEach((card) => {
      card.addEventListener(
        'pointermove',
        (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          card.style.setProperty('--rx', `${(0.5 - y) * MAX_TILT}deg`);
          card.style.setProperty('--ry', `${(x - 0.5) * MAX_TILT}deg`);
        },
        { passive: true }
      );
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--rx');
        card.style.removeProperty('--ry');
      });
    });
  }
</script>

<style>
  /* Tighten Stats → Services gap (override .section padding-block) */
  .services {
    padding-top: var(--space-16);
  }

  /* ===== Section header: animated reveal ===== */
  .services-head { position: relative; }

  .services-eyebrow {
    display: inline-block;
    background: linear-gradient(90deg, var(--color-brand-700), var(--color-brand-purple));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0;
    transform: translateX(-14px);
    transition: opacity 600ms var(--ease-spring), transform 600ms var(--ease-spring);
    transition-delay: 80ms;
  }

  .services-title {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(6px);
    transition: opacity 700ms var(--ease-spring), transform 700ms var(--ease-spring),
      filter 700ms ease;
    transition-delay: 200ms;
  }

  .services-title .title-accent {
    background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-purple) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 200% 200%;
    animation: titleAccentShift 6s ease-in-out infinite;
  }
  @keyframes titleAccentShift {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  /* Gradient underline that grows on scroll-in */
  .services-head::after {
    content: '';
    display: block;
    margin: var(--space-3) auto 0;
    width: 0;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-brand-500), var(--color-brand-purple));
    transition: width 700ms var(--ease-spring);
    transition-delay: 480ms;
  }

  .services-lead {
    opacity: 0;
    transition: opacity 600ms ease;
    transition-delay: 360ms;
  }
  .services-lead .kw {
    opacity: 0;
    display: inline-block;
    transform: translateY(8px);
    font-weight: 600;
    transition: opacity 500ms var(--ease-spring), transform 500ms var(--ease-spring);
  }
  .kw-1 { color: var(--color-brand-700); }
  .kw-2 { color: var(--color-brand-purple); }
  .kw-3 { color: var(--color-brand-500); }
  .kw-4 { color: #0E7490; }
  .kw-5 { color: #B45309; }

  /* Trigger reveal when section-head becomes visible */
  .services-head.is-visible .services-eyebrow,
  .services-head.is-visible .services-title {
    opacity: 1;
    transform: translate(0);
    filter: blur(0);
  }
  .services-head.is-visible::after { width: 88px; }
  .services-head.is-visible .services-lead { opacity: 1; }
  .services-head.is-visible .kw {
    opacity: 1;
    transform: translateY(0);
  }
  .services-head.is-visible .kw-1 { transition-delay: 540ms; }
  .services-head.is-visible .kw-2 { transition-delay: 660ms; }
  .services-head.is-visible .kw-3 { transition-delay: 780ms; }
  .services-head.is-visible .kw-4 { transition-delay: 900ms; }
  .services-head.is-visible .kw-5 { transition-delay: 1020ms; }

  /* Override the parent .reveal opacity — we drive child reveals manually */
  .services-head.reveal {
    opacity: 1;
    transform: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .service-card {
    gap: var(--space-4);
    position: relative;
    overflow: hidden;
    /* Override .card hover translateY — 3D tilt handles the lift via translateZ */
    transform: perspective(1000px)
      rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 320ms var(--ease-spring),
      box-shadow 250ms var(--ease-spring),
      border-color 250ms ease;
  }

  /* Real brand-asset watermark — top-right of each card.
     Idle "breathing" animation; hover boosts opacity + scale + rotation. */
  .card-watermark {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    transform-origin: top right;
    will-change: transform, opacity;
    animation: wmBreathe 5.5s ease-in-out infinite;
    transition: opacity 380ms ease,
      transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 380ms ease;
  }
  .watermark-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
  /* 1C logo: red SVG on yellow brand-badge background */
  .wm-1c {
    top: 18px;
    right: 18px;
    width: 118px;
    height: 60px;
    padding: 8px 14px;
    background: #FFCD00;
    border-radius: 8px;
    opacity: 0.85;
    box-shadow: 0 4px 14px rgba(217, 25, 32, 0.18);
  }
  /* Bitrix24 logo: horizontal lockup, top-right */
  .wm-b24 {
    top: 22px;
    right: 18px;
    width: 130px;
    height: 28px;
    opacity: 0.7;
    filter: drop-shadow(0 2px 6px rgba(10, 159, 212, 0.2));
  }
  /* Web code photo: dissolves into card via radial mask, no hard edges */
  .wm-web {
    top: 8px;
    right: 8px;
    width: 160px;
    height: 110px;
    opacity: 0.7;
    overflow: hidden;
    filter: saturate(1.05) contrast(1.05);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, #000 45%, rgba(0,0,0,0.5) 75%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, #000 45%, rgba(0,0,0,0.5) 75%, transparent 100%);
  }
  .wm-web .watermark-img { object-fit: cover; }
  /* POS terminal photo — same soft-dissolve treatment, slightly stronger */
  .wm-pos {
    top: 8px;
    right: 8px;
    width: 160px;
    height: 110px;
    opacity: 0.85;
    overflow: hidden;
    filter: saturate(1.1) contrast(1.08);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, #000 50%, rgba(0,0,0,0.5) 78%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, #000 50%, rgba(0,0,0,0.5) 78%, transparent 100%);
  }
  .wm-pos .watermark-img { object-fit: cover; }

  /* Idle breathing — subtle scale + opacity pulse so it feels alive */
  @keyframes wmBreathe {
    0%, 100% { transform: scale(1)    translateY(0); }
    50%      { transform: scale(1.04) translateY(-2px); }
  }

  /* Hover: kill idle breathe, play expressive POP keyframe — bigger + bouncy */
  @keyframes wmPop {
    0%   { transform: scale(1)    rotate(0deg); }
    55%  { transform: scale(1.62) rotate(-7deg); }
    78%  { transform: scale(1.42) rotate(-3deg); }
    100% { transform: scale(1.5)  rotate(-5deg); }
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover .card-watermark {
      animation: wmPop 620ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      opacity: 1;
    }
    .service-card:hover .wm-web,
    .service-card:hover .wm-pos {
      opacity: 1;
    }
    .service-card:hover .wm-1c {
      box-shadow: 0 12px 30px rgba(217, 25, 32, 0.42);
    }
    .service-card:hover .wm-b24 {
      filter: drop-shadow(0 10px 26px rgba(10, 159, 212, 0.55));
    }
  }

  /* Lift card content above watermark */
  .service-card > *:not(.card-watermark) {
    position: relative;
    z-index: 1;
  }
  /* Title needs right padding so it doesn't slide under the watermark */
  .service-card .h3 {
    padding-right: 96px;
  }

  @media (max-width: 600px) {
    .wm-1c     { width: 96px; height: 48px; padding: 6px 10px; top: 16px; right: 16px; }
    .wm-b24    { width: 104px; height: 22px; top: 20px; right: 16px; }
    .wm-web,
    .wm-pos    { width: 130px; height: 90px; top: 10px; right: 10px; }
    .service-card .h3 { padding-right: 76px; }
  }

  /* Override the .card:hover translateY (it conflicts with 3D rotate) */
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      transform: perspective(1000px)
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        translateZ(8px);
    }
  }

  .icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-500);
    transition: transform 280ms var(--ease-spring), background 220ms ease,
      border-color 220ms ease;
  }
  .service-card:hover .icon-wrap {
    background: rgba(37, 99, 235, 0.08);
    border-color: var(--color-brand-500);
    transform: rotate(-6deg) scale(1.05);
  }

  .service-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .service-bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    flex-grow: 1;
  }
  .service-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-text-soft);
    line-height: 1.45;
  }
  .bullet-check {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* Reveal block: price + TG CTA. Always reserves space (height stable) — fades in on hover. */
  .service-reveal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 240ms ease, transform 320ms var(--ease-spring);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover .service-reveal,
    .service-card:focus-within .service-reveal {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  /* On touch devices reveal is permanently visible — no hover possible */
  @media (hover: none), (pointer: coarse) {
    .service-reveal {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  .service-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    flex-shrink: 0;
  }
  .price-from {
    font-size: 0.8125rem;
    color: var(--color-text-soft);
    font-weight: 500;
  }
  .price-value {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 14px;
    background: var(--color-brand-500);
    color: #fff;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
    transition: transform 200ms var(--ease-spring),
      background-color 200ms ease,
      box-shadow 200ms ease;
    margin-left: auto;
  }
  .service-cta:hover {
    background: var(--color-brand-600);
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.36);
  }

  /* ===== Border-glow on hover (animated conic-gradient + @property --bg-angle).
     Scoped to (hover: hover) so touch browsers don't parse/composite the
     conic-gradient layer. ===== */
  @property --bg-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes service-bg-spin {
    to { --bg-angle: 360deg; }
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card {
      isolation: isolate;
    }
    .service-card::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      background:
        linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
        conic-gradient(
          from var(--bg-angle),
          var(--color-brand-500),
          var(--color-brand-purple),
          var(--color-brand-500)
        ) border-box;
      border: 2px solid transparent;
      z-index: -1;
      pointer-events: none;
      opacity: 0;
      animation: service-bg-spin 5s linear infinite paused;
      transition: opacity 320ms ease;
    }
    .service-card:hover::after,
    .service-card:focus-within::after {
      opacity: 1;
      animation-play-state: running;
    }
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services {
      padding-top: var(--space-12);
    }
    /* On smaller cards stack price above CTA — keeps button full-width */
    .service-reveal {
      flex-direction: column;
      align-items: stretch;
    }
    .service-cta {
      margin-left: 0;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transform: none !important;
      transition: none;
    }
    .service-reveal {
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
      transition: none;
    }
    .services-eyebrow,
    .services-title,
    .services-lead,
    .services-lead .kw {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .services-title .title-accent { animation: none !important; }
    .services-head::after { width: 88px !important; transition: none !important; }
    .card-watermark {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>
