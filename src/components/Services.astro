---
import Icon from './Icon.astro';

const services = [
  {
    icon: 'code',
    title: '1С Разработка',
    description: 'Прикладные решения и интеграции под ваши процессы.',
    bullets: ['Типовые конфигурации и доработки', 'Разработка с нуля', 'Интеграция с CRM, банком, маркетплейсами'],
  },
  {
    icon: 'wrench',
    title: 'Обслуживание 1С',
    description: 'Техподдержка, обновления и бэкапы — без простоев.',
    bullets: ['Обновления каждый месяц', 'Регламентные резервные копии', 'Поддержка по телефону и удалённо'],
  },
  {
    icon: 'globe',
    title: 'Разработка сайтов',
    description: 'WordPress, Tilda и лендинги с интеграцией с 1С.',
    bullets: ['Каталог и остатки из 1С', 'Онлайн-оплата и заявки в CRM', 'SEO-оптимизация под Яндекс'],
  },
  {
    icon: 'shield',
    title: '1С:ИТС',
    description: 'Официальные лицензии и ИТ-сопровождение по подписке.',
    bullets: ['Активация за день', 'Автообновления конфигураций', 'Линия консультаций 1С'],
  },
  {
    icon: 'server',
    title: 'Подбор оборудования',
    description: 'Серверы, кассы и сканеры — установка под ключ.',
    bullets: ['Подбор под бюджет и задачу', 'Поставка от партнёров', 'Монтаж и настройка'],
  },
  {
    icon: 'chart',
    title: 'Битрикс-24',
    description: 'CRM, портал и обмен с 1С — настраиваем под ваш отдел.',
    bullets: ['Воронки продаж и роботы', 'Телефония и почта', 'Двусторонний обмен с 1С'],
  },
];
---

<section class="section services" id="services">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">Услуги</span>
      <h2 class="h2">Что мы делаем</h2>
      <p class="lead">
        От разработки 1С до интеграций с Битрикс-24 — закрываем весь цикл автоматизации.
      </p>
    </header>

    <ul class="grid reveal-stagger">
      {services.map((service) => (
        <li class="card service-card">
          <div class="icon-wrap">
            <Icon name={service.icon} size={28} />
          </div>
          <h3 class="h3">{service.title}</h3>
          <p class="text-soft service-desc">{service.description}</p>
          <ul class="service-bullets">
            {service.bullets.map((b) => (
              <li>
                <Icon name="check" size={14} class="bullet-check" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <a href="#contacts" class="service-link">
            Узнать подробнее
            <Icon name="arrow-right" size={14} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Tighten Stats → Services gap (override .section padding-block) */
  .services {
    padding-top: var(--space-16);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .service-card {
    gap: var(--space-4);
    position: relative;
  }

  .icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-500);
    transition: transform 280ms var(--ease-spring), background 220ms ease,
      border-color 220ms ease;
  }
  .service-card:hover .icon-wrap {
    background: rgba(37, 99, 235, 0.08);
    border-color: var(--color-brand-500);
    transform: rotate(-6deg) scale(1.05);
  }

  .service-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .service-bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    flex-grow: 1;
  }
  .service-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-text-soft);
    line-height: 1.45;
  }
  .bullet-check {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-500);
    margin-top: auto;
    transition: gap 200ms var(--ease-spring), color 200ms;
  }
  .service-card:hover .service-link {
    gap: 10px;
    color: var(--color-brand-600);
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services {
      padding-top: var(--space-12);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
