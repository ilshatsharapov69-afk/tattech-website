---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

const cols = [
  {
    title: 'Услуги',
    links: [
      { label: '1С разработка', href: `${base}/1s-razrabotka` },
      { label: 'Обслуживание 1С', href: `${base}/obsluzhivanie-1s` },
      { label: 'Разработка сайтов', href: `${base}/razrabotka-sajtov` },
      { label: '1С:ИТС', href: `${base}/1s-its` },
      { label: 'Подбор оборудования', href: `${base}/podbor-i-ustanovka-oborudovaniya` },
      { label: 'Битрикс24', href: `${base}/vnedrenie-bitriks-24` },
    ],
  },
  {
    title: 'Программы 1С',
    links: [
      { label: '1С:Бухгалтерия', href: `${base}/programmy-1s` },
      { label: '1С:Управление торговлей', href: `${base}/programmy-1s` },
      { label: '1С:Документооборот', href: `${base}/programmy-1s` },
      { label: '1С:Розница', href: `${base}/programmy-1s` },
      { label: '1С:ЗУП', href: `${base}/programmy-1s` },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="grid">
      <div class="brand-col">
        <a href={`${base}/`} class="logo">
          <img
            src={`${base}/images/logo-circle.webp`}
            alt="T-Tech"
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <span>T-Tech</span>
        </a>
        <p class="brand-desc">
          Автоматизация бизнеса на 1С с 2016&nbsp;года в&nbsp;Казани и&nbsp;по&nbsp;всей России.
        </p>
        <div class="socials">
          <a href="https://t.me/CyclesOfID" target="_blank" rel="noopener" aria-label="Telegram" class="social-btn">
            <Icon name="telegram" size={18} />
          </a>
          <a href="https://wa.me/79950958536" target="_blank" rel="noopener" aria-label="WhatsApp" class="social-btn">
            <Icon name="whatsapp" size={18} />
          </a>
          <a href="mailto:ttech.kzn.it@gmail.com" aria-label="Email" class="social-btn">
            <span style="font-size:18px">✉</span>
          </a>
        </div>
      </div>

      {cols.map((col) => (
        <div>
          <h3 class="col-title">{col.title}</h3>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="col-title">Контакты</h3>
        <ul class="contacts-list">
          <li>
            <span class="ci">📍</span>
            <span>Казань, ул.&nbsp;Дубравная, 43а</span>
          </li>
          <li>
            <a href="tel:+79520434277" class="footer-link">
              <span class="ci">📞</span>
              <span>+7 952 043 4277</span>
            </a>
          </li>
          <li>
            <a href="mailto:ttech.kzn.it@gmail.com" class="footer-link">
              <span class="ci">✉</span>
              <span>ttech.kzn.it@gmail.com</span>
            </a>
          </li>
          <li class="hours">
            <span class="ci">🕒</span>
            <span>Пн-Пт, 9:00–18:00 МСК</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} T-Tech. Все права защищены.</span>
      <span class="legal-sep">•</span>
      <a href={`${base}/privacy`} class="footer-link">Политика конфиденциальности</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.7);
    padding-block: var(--space-24) var(--space-8);
    font-size: 0.9375rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: var(--space-12);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
  }
  .logo img {
    width: 44px;
    height: 44px;
  }

  .brand-desc {
    margin-top: var(--space-4);
    line-height: 1.55;
    max-width: 320px;
  }

  .socials {
    display: flex;
    gap: 10px;
    margin-top: var(--space-5);
  }
  .social-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 200ms ease;
  }
  .social-btn:hover {
    background: var(--color-brand-500);
    transform: translateY(-2px);
  }

  .col-title {
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-4);
  }

  .footer-link {
    color: rgba(255, 255, 255, 0.7);
    transition: color 200ms;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .footer-link:hover {
    color: #fff;
  }

  ul li {
    padding-block: 6px;
  }

  .contacts-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.5;
  }
  .ci {
    flex-shrink: 0;
    opacity: 0.8;
  }
  .hours {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.875rem;
  }

  .bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .legal-sep {
    opacity: 0.4;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    .legal-sep {
      display: none;
    }
  }
</style>
