---
const steps = [
  {
    n: '01',
    title: 'Бриф',
    duration: '30 минут',
    desc: 'Узнаём задачу, текущие процессы, что болит. Без предоплаты и обязательств.',
  },
  {
    n: '02',
    title: 'Аудит и&nbsp;ТЗ',
    duration: '3–5 дней',
    desc: 'Фиксируем объём работ, сроки и стоимость. Подписываем договор по этапам.',
  },
  {
    n: '03',
    title: 'Внедрение',
    duration: 'от 2 недель',
    desc: 'Настраиваем 1С и интеграции. Каждую неделю показываем демо и собираем правки.',
  },
  {
    n: '04',
    title: 'Обучение',
    duration: '1–2 дня',
    desc: 'Тренинг для пользователей + видеоинструкции — чтобы команда не тонула после запуска.',
  },
  {
    n: '05',
    title: 'Поддержка',
    duration: '5/2 после запуска',
    desc: 'Отвечаем на вопросы, делаем доработки, обновляем 1С. По фиксированному тарифу.',
  },
];
---

<section class="section process" id="process">
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">Как мы работаем</span>
      <h2 class="h2">От первого звонка до&nbsp;поддержки</h2>
      <p class="lead">
        Каждый этап — с фиксированным результатом и сроком. Договор подписываем после ТЗ, не «на пустом месте».
      </p>
    </header>

    <ol class="process-list reveal-stagger">
      {steps.map((step) => (
        <li class="process-step">
          <div class="step-num" aria-hidden="true">{step.n}</div>
          <div class="step-body">
            <div class="step-head">
              <h3 class="h3 step-title" set:html={step.title} />
              <span class="step-duration">{step.duration}</span>
            </div>
            <p class="text-soft step-desc">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--color-bg-tint);
  }

  .process-list {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 880px;
    margin-inline: auto;
  }

  /* Per-step accent color — drives number, pill, glow, pulse-ring */
  .process-step {
    --step-color: var(--color-brand-500);
    --step-color-soft: rgba(37, 99, 235, 0.14);
    --step-color-glow: rgba(37, 99, 235, 0.30);
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-6);
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    transition: border-color 220ms ease, box-shadow 220ms var(--ease-spring),
      transform 220ms var(--ease-spring);
    animation: stepPulse 4.5s ease-in-out infinite;
    animation-delay: calc(var(--step-i, 0) * 480ms);
  }
  .process-step:nth-child(1) {
    --step-i: 0;
    --step-color: #0EA5E9;
    --step-color-soft: rgba(14, 165, 233, 0.13);
    --step-color-glow: rgba(14, 165, 233, 0.32);
  }
  .process-step:nth-child(2) {
    --step-i: 1;
    --step-color: #2563EB;
    --step-color-soft: rgba(37, 99, 235, 0.14);
    --step-color-glow: rgba(37, 99, 235, 0.32);
  }
  .process-step:nth-child(3) {
    --step-i: 2;
    --step-color: #635BFF;
    --step-color-soft: rgba(99, 91, 255, 0.16);
    --step-color-glow: rgba(99, 91, 255, 0.34);
  }
  .process-step:nth-child(4) {
    --step-i: 3;
    --step-color: #F59E0B;
    --step-color-soft: rgba(245, 158, 11, 0.18);
    --step-color-glow: rgba(245, 158, 11, 0.36);
  }
  .process-step:nth-child(5) {
    --step-i: 4;
    --step-color: #10B981;
    --step-color-soft: rgba(16, 185, 129, 0.16);
    --step-color-glow: rgba(16, 185, 129, 0.34);
  }

  .process-step:hover {
    border-color: var(--step-color);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .step-num {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--step-color);
    transition: transform 320ms var(--ease-spring);
    animation: numPulse 4.5s ease-in-out infinite;
    animation-delay: calc(var(--step-i, 0) * 480ms);
    transform-origin: left center;
  }

  .step-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .step-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .step-title {
    margin: 0;
  }
  .step-duration {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--step-color);
    background: var(--step-color-soft);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .step-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* Sequential wave: card briefly glows in its own colour, then settles */
  @keyframes stepPulse {
    0%, 80%, 100% {
      border-color: var(--color-border);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    8% {
      border-color: var(--step-color);
      box-shadow:
        0 0 0 4px var(--step-color-glow),
        0 12px 28px var(--step-color-soft);
    }
    22% {
      border-color: var(--step-color);
      box-shadow:
        0 0 0 0 transparent,
        0 6px 18px var(--step-color-soft);
    }
  }
  @keyframes numPulse {
    0%, 80%, 100% { transform: scale(1); }
    10% { transform: scale(1.22); }
  }

  @media (max-width: 640px) {
    .process-step {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-5) var(--space-6);
    }
    .step-num {
      font-size: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step,
    .step-num {
      animation: none !important;
    }
  }
</style>
