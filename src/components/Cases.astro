---
import Icon from './Icon.astro';
import { cases as allCases } from '../data/cases.ts';

interface Props {
  tags?: string[];
  eyebrow?: string;
  title?: string;
  lead?: string;
  sectionId?: string;
}

const {
  tags,
  eyebrow = 'Кейсы',
  title = 'Что меняется после внедрения',
  lead = '9 лет, 420 проектов — у каждого конкретная задача, фиксированный срок и измеримый результат.',
  sectionId = 'cases',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cases = tags && tags.length > 0
  ? allCases.filter((c) => tags.includes(c.industry))
  : allCases;
const gridId = `${sectionId}-grid`;
---

<section class="section cases" id={sectionId}>
  <div class="container">
    <header class="section-head reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{title}</h2>
      <p class="lead">{lead}</p>
    </header>

    <div class="cases-grid" id={gridId}>
      {cases.map((c) => {
        const slug = c.img;
        const srcset = [640, 960, 1200]
          .map((w) => `${base}/images/cases/${slug}-${w}.webp ${w}w`)
          .join(', ');
        return (
          <article class="case-card spotlight-card" data-tag={c.industry}>
            <div class="case-media">
              <img
                src={`${base}/images/cases/${slug}-960.webp`}
                srcset={srcset}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 290px"
                alt={`Кейс: ${c.industry}`}
                loading="lazy"
                decoding="async"
                width="1200"
                height="675"
              />
            </div>
            <div class="case-body">
              <h3 class="h3 case-title" style={`color:${c.color}`}>{c.industry}</h3>
              <p class="case-pain">{c.pain}</p>
              <div class="case-solution">
                <Icon name="check" size={14} class="case-check" />
                <span>{c.solution}</span>
              </div>
            </div>
            <div class="case-strip">
              <div class="case-metric">{c.metric}</div>
              <div class="case-deadline">{c.deadline}</div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .cases {
    background: linear-gradient(180deg, #fff 0%, var(--color-bg-tint) 60%);
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .case-card {
    position: relative;
    isolation: isolate;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 250ms var(--ease-spring), box-shadow 250ms var(--ease-spring),
      border-color 250ms ease;
  }
  .case-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand-500);
    box-shadow: var(--shadow-card-hover);
  }

  .case-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  .case-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .case-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.22) 0%, transparent 55%);
    pointer-events: none;
  }
  .case-body {
    padding: var(--space-5) var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .case-title {
    font-size: 1.0625rem;
    line-height: 1.3;
    margin: 0;
  }
  .case-pain {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-soft);
    margin: 0;
  }
  .case-solution {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-text);
    font-weight: 500;
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .case-check {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .case-strip {
    padding: var(--space-3) var(--space-5);
    background: rgba(37, 99, 235, 0.06);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .case-metric {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .case-deadline {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-soft);
    letter-spacing: 0.01em;
  }

  /* 3D tilt + spotlight gradient + image hover-zoom — desktop only */
  @media (hover: hover) and (pointer: fine) {
    .case-card {
      transform: perspective(1000px)
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg));
      transform-style: preserve-3d;
      transition: transform 320ms var(--ease-spring),
        box-shadow 250ms var(--ease-spring),
        border-color 250ms ease;
    }
    .case-card:hover {
      transform: perspective(1000px)
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        translateZ(10px);
    }
    .case-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(
        420px circle at var(--mx, 50%) var(--my, 50%),
        rgba(37, 99, 235, 0.18),
        transparent 65%
      );
      opacity: 0;
      transition: opacity 280ms ease;
      pointer-events: none;
      z-index: 0;
    }
    .case-card:hover::before,
    .case-card:focus-within::before {
      opacity: 1;
    }
    .case-card > * {
      position: relative;
      z-index: 1;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .case-card:hover .case-media img,
    .case-card:focus-within .case-media img {
      transform: scale(1.08);
      will-change: transform;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-card::before {
      display: none;
    }
    .case-media img {
      transition: none;
    }
    .case-card,
    .case-card:hover {
      transform: none !important;
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    .cases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cases-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>

<script>
  // Per-card spotlight — delegated pointermove + cached getBoundingClientRect.
  // No-op on touch devices and under prefers-reduced-motion.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (!reduced && canHover) {
    document.querySelectorAll<HTMLElement>('.cases-grid').forEach((grid) => {
      const rectCache = new WeakMap<Element, DOMRect>();
      const MAX_TILT = 8; // degrees

      grid.addEventListener(
        'pointermove',
        (event) => {
          const card = (event.target as HTMLElement).closest('.spotlight-card') as HTMLElement | null;
          if (!card) return;
          let rect = rectCache.get(card);
          if (!rect) {
            rect = card.getBoundingClientRect();
            rectCache.set(card, rect);
          }
          const localX = event.clientX - rect.left;
          const localY = event.clientY - rect.top;
          card.style.setProperty('--mx', `${localX}px`);
          card.style.setProperty('--my', `${localY}px`);
          const nx = localX / rect.width;   // 0..1
          const ny = localY / rect.height;  // 0..1
          card.style.setProperty('--rx', `${(0.5 - ny) * MAX_TILT}deg`);
          card.style.setProperty('--ry', `${(nx - 0.5) * MAX_TILT}deg`);
        },
        { passive: true }
      );

      grid.querySelectorAll<HTMLElement>('.spotlight-card').forEach((card) => {
        card.addEventListener('pointerleave', () => {
          card.style.removeProperty('--rx');
          card.style.removeProperty('--ry');
        });
      });

      const invalidateCache = () => {
        grid.querySelectorAll('.spotlight-card').forEach((c) => rectCache.delete(c));
      };
      window.addEventListener('scroll', invalidateCache, { passive: true });
      const ro = new ResizeObserver(invalidateCache);
      ro.observe(grid);
    });
  }
</script>
