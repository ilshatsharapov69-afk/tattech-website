---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: `${base}/uslugi`, label: 'Услуги' },
  { href: `${base}/programmy-1s`, label: 'Программы 1С' },
  { href: `${base}/nashi-kejsi`, label: 'Кейсы' },
  { href: `${base}/contacts`, label: 'Контакты' },
];
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <a href={`${base}/`} class="logo">
      <img
        src={`${base}/images/logo-circle.webp`}
        alt="T-Tech"
        width="36"
        height="36"
        loading="eager"
        decoding="async"
      />
      <span class="logo-text">T-Tech</span>
    </a>

    <nav class="nav" aria-label="Главное меню">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href="tel:+79520434277" class="phone">+7 952 043 4277</a>
      <a
        href="mailto:ttech.kzn.it@gmail.com"
        class="ic-btn ic-btn-email"
        data-copy-email="ttech.kzn.it@gmail.com"
        aria-label="Написать на email"
      >
        <Icon name="email" size={18} />
      </a>
      <a
        href="https://t.me/CyclesOfID"
        target="_blank"
        rel="noopener"
        class="ic-btn ic-btn-tg"
        aria-label="Написать в Telegram"
      >
        <Icon name="telegram" size={18} />
      </a>
      <a
        href="https://wa.me/79950958536"
        target="_blank"
        rel="noopener"
        class="ic-btn ic-btn-wa"
        aria-label="Написать в WhatsApp"
      >
        <Icon name="whatsapp" size={18} />
      </a>
    </div>

    <button class="burger" aria-label="Открыть меню" aria-expanded="false" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="copy-toast" id="copy-toast" role="status" aria-live="polite"></div>

  <div class="mobile-menu" id="mobile-menu" inert>
    <nav aria-label="Мобильное меню">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href} class="mobile-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mobile-actions">
      <a href="tel:+79520434277" class="mobile-phone">+7 952 043 4277</a>
      <div class="mobile-channels">
        <a
          href="mailto:ttech.kzn.it@gmail.com"
          class="ic-btn ic-btn-email-mobile"
          data-copy-email="ttech.kzn.it@gmail.com"
          aria-label="Написать на email"
        >
          <Icon name="email" size={18} />
        </a>
        <a
          href="https://t.me/CyclesOfID"
          target="_blank"
          rel="noopener"
          class="ic-btn ic-btn-tg"
          aria-label="Написать в Telegram"
        >
          <Icon name="telegram" size={18} />
        </a>
        <a
          href="https://wa.me/79950958536"
          target="_blank"
          rel="noopener"
          class="ic-btn ic-btn-wa"
          aria-label="Написать в WhatsApp"
        >
          <Icon name="whatsapp" size={18} />
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    /* Default: light frosted-glass over Hero gradient (no jarring jump on scroll). */
    background: linear-gradient(180deg, rgba(30, 58, 138, 0.22) 0%, rgba(37, 99, 235, 0.16) 100%);
    backdrop-filter: saturate(160%) blur(8px);
    -webkit-backdrop-filter: saturate(160%) blur(8px);
    transition: background 240ms ease, box-shadow 240ms ease, backdrop-filter 240ms ease;
  }
  .header.is-scrolled {
    background: linear-gradient(180deg, rgba(30, 58, 138, 0.92) 0%, rgba(37, 99, 235, 0.82) 100%);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 2px 24px rgba(30, 58, 138, 0.18);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.125rem;
    color: #fff;
    flex-shrink: 0;
  }
  .logo img {
    width: 36px;
    height: 36px;
  }
  .logo-text {
    letter-spacing: -0.01em;
    color: #fff;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: var(--space-6);
  }
  .nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    transition: color 200ms ease;
    padding: 6px 2px;
    position: relative;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 0;
    height: 2px;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease-spring);
  }
  .nav a:hover {
    color: #fff;
  }
  .nav a:hover::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: var(--space-4);
  }
  .phone {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #fff;
    transition: opacity 200ms;
  }
  .phone:hover {
    opacity: 0.85;
  }
  .ic-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border: none;
    position: relative;
    transition: background-color 200ms ease, transform 200ms var(--ease-spring), box-shadow 200ms ease;
  }
  /* Sequential ripple wave on the 3 contact buttons (left → right). */
  .ic-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: 0 0 0 0 var(--wave-color, transparent);
    animation: icWave 3.4s cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
  }
  .ic-btn-email::before { --wave-color: rgba(255, 255, 255, 0.55); animation-delay: 0ms;   }
  .ic-btn-tg::before    { --wave-color: rgba(34, 158, 217, 0.65);  animation-delay: 450ms; }
  .ic-btn-wa::before    { --wave-color: rgba(37, 211, 102, 0.65);  animation-delay: 900ms; }
  .ic-btn-email-mobile::before { --wave-color: rgba(37, 99, 235, 0.5); }
  @keyframes icWave {
    0%   { box-shadow: 0 0 0 0    var(--wave-color); }
    55%  { box-shadow: 0 0 0 16px rgba(0, 0, 0, 0); }
    100% { box-shadow: 0 0 0 0    rgba(0, 0, 0, 0); }
  }
  /* Click feedback flash for email copy */
  .ic-btn.is-copied {
    transform: scale(1.15);
    transition: transform 180ms var(--ease-spring);
  }
  .ic-btn-tg {
    background: #229ED9;
  }
  .ic-btn-tg:hover {
    background: #1B8CC0;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(34, 158, 217, 0.4);
  }
  .ic-btn-wa {
    background: #25D366;
  }
  .ic-btn-wa:hover {
    background: #1FAE57;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(37, 211, 102, 0.4);
  }
  .ic-btn-email {
    background: rgba(255, 255, 255, 0.10);
  }
  .ic-btn-email:hover {
    background: rgba(255, 255, 255, 0.20);
    transform: translateY(-2px);
  }
  /* Mobile menu sits on white panel — email needs brand-tinted bg there */
  .ic-btn-email-mobile {
    background: rgba(37, 99, 235, 0.10);
    color: var(--color-brand-500);
  }
  .ic-btn-email-mobile:hover {
    background: var(--color-brand-500);
    color: #fff;
    transform: translateY(-2px);
  }
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    margin-left: auto;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 240ms var(--ease-spring), opacity 200ms ease;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .mobile-menu {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: var(--space-5) var(--container-pad) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.12);
    transform: translateY(-105%);
    transition: transform 320ms var(--ease-spring), opacity 220ms ease;
    opacity: 0;
    pointer-events: none;
    z-index: 99;
  }
  .mobile-menu.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mobile-link {
    display: block;
    padding: var(--space-3) 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-actions {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
    margin-top: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }
  .mobile-actions .btn {
    flex-shrink: 0;
  }
  .mobile-phone {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-brand-500);
    margin-right: auto;
  }
  .mobile-channels {
    display: inline-flex;
    gap: var(--space-2);
  }

  @media (max-width: 960px) {
    .nav,
    .actions {
      display: none;
    }
    .burger {
      display: flex;
    }
  }

  /* Toast that confirms email-copy action */
  .copy-toast {
    position: fixed;
    top: calc(var(--header-h) + 12px);
    right: var(--container-pad);
    z-index: 110;
    background: rgba(15, 23, 42, 0.92);
    color: #fff;
    padding: 10px 16px;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.25);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 280ms var(--ease-spring);
  }
  .copy-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ic-btn::before { animation: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');

  let menuOpenAtY = 0;

  const isMenuOpen = () => menu?.classList.contains('is-open') ?? false;

  const toggle = (open?: boolean) => {
    if (!menu || !burger) return;
    const next = open ?? !menu.classList.contains('is-open');
    menu.classList.toggle('is-open', next);
    if (next) menu.removeAttribute('inert');
    else menu.setAttribute('inert', '');
    burger.setAttribute('aria-expanded', String(next));
    if (next) menuOpenAtY = window.scrollY;
  };

  const onScroll = () => {
    if (header) {
      if (window.scrollY > 30) header.classList.add('is-scrolled');
      else header.classList.remove('is-scrolled');
    }
    if (isMenuOpen() && Math.abs(window.scrollY - menuOpenAtY) > 20) {
      toggle(false);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Close menu when resizing past mobile breakpoint
  window.addEventListener('resize', () => {
    if (window.innerWidth > 960 && isMenuOpen()) toggle(false);
  });

  if (burger && menu) {
    burger.addEventListener('click', () => toggle());
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => toggle(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }

  // Email-copy with toast feedback (mailto: still fires for users with a client)
  const toast = document.getElementById('copy-toast');
  let toastTimer: number | undefined;
  const showToast = (msg: string) => {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('is-visible');
    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 2200);
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.copyEmail;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        showToast(`Email скопирован: ${email}`);
      } catch {
        showToast(email);
      }
      btn.classList.add('is-copied');
      window.setTimeout(() => btn.classList.remove('is-copied'), 220);
    });
  });
</script>
