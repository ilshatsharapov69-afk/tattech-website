---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: '#services', label: 'Услуги' },
  { href: '#programs', label: 'Программы 1С' },
  { href: '#cases', label: 'Кейсы' },
  { href: '#contacts', label: 'Контакты' },
];
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <a href={`${base}/`} class="logo">
      <img
        src={`${base}/images/logo-circle.webp`}
        alt="T-Tech"
        width="36"
        height="36"
        loading="eager"
        decoding="async"
      />
      <span class="logo-text">T-Tech</span>
    </a>

    <nav class="nav" aria-label="Главное меню">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href="tel:+79520434277" class="phone">+7 952 043 4277</a>
      <a
        href="https://t.me/CyclesOfID"
        target="_blank"
        rel="noopener"
        class="ic-btn"
        aria-label="Написать в Telegram"
      >
        <Icon name="telegram" size={18} />
      </a>
      <a
        href="https://wa.me/79950958536"
        target="_blank"
        rel="noopener"
        class="ic-btn"
        aria-label="Написать в WhatsApp"
      >
        <Icon name="whatsapp" size={18} />
      </a>
    </div>

    <button class="burger" aria-label="Открыть меню" aria-expanded="false" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" inert>
    <nav aria-label="Мобильное меню">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href} class="mobile-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mobile-actions">
      <a href="tel:+79520434277" class="mobile-phone">+7 952 043 4277</a>
      <div class="mobile-channels">
        <a
          href="https://t.me/CyclesOfID"
          target="_blank"
          rel="noopener"
          class="ic-btn ic-btn-mobile"
          aria-label="Написать в Telegram"
        >
          <Icon name="telegram" size={18} />
        </a>
        <a
          href="https://wa.me/79950958536"
          target="_blank"
          rel="noopener"
          class="ic-btn ic-btn-mobile"
          aria-label="Написать в WhatsApp"
        >
          <Icon name="whatsapp" size={18} />
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    transition: background-color 240ms ease, box-shadow 240ms ease, backdrop-filter 240ms ease;
  }
  .header.is-scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    box-shadow: var(--shadow-sm);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .logo img {
    width: 36px;
    height: 36px;
  }
  .logo-text {
    letter-spacing: -0.01em;
    transition: color 240ms ease;
  }

  /* Over the dark Hero (header transparent, not yet scrolled) — light text */
  .header:not(.is-scrolled) .logo,
  .header:not(.is-scrolled) .logo-text,
  .header:not(.is-scrolled) .phone {
    color: #fff;
  }
  .header:not(.is-scrolled) .nav a {
    color: rgba(255, 255, 255, 0.85);
  }
  .header:not(.is-scrolled) .nav a:hover {
    color: #fff;
  }
  .header:not(.is-scrolled) .nav a::after {
    background: #fff;
  }
  .header:not(.is-scrolled) .burger span {
    background: #fff;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: var(--space-6);
  }
  .nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-soft);
    transition: color 200ms ease;
    padding: 6px 2px;
    position: relative;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 0;
    height: 2px;
    background: var(--color-brand-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease-spring);
  }
  .nav a:hover {
    color: var(--color-text);
  }
  .nav a:hover::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: var(--space-4);
  }
  .phone {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 200ms;
  }
  .phone:hover {
    color: var(--color-brand-500);
  }
  .ic-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-brand-500);
    border: 1px solid transparent;
    transition: background-color 200ms ease, color 200ms ease, transform 200ms var(--ease-spring), border-color 200ms ease;
  }
  .ic-btn:hover {
    background: var(--color-brand-500);
    color: #fff;
    transform: translateY(-2px);
  }
  /* Over the dark Hero — glassmorphic */
  .header:not(.is-scrolled) .ic-btn {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .header:not(.is-scrolled) .ic-btn:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.6);
  }
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    margin-left: auto;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 240ms var(--ease-spring), opacity 200ms ease;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .mobile-menu {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: var(--space-5) var(--container-pad) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.12);
    transform: translateY(-105%);
    transition: transform 320ms var(--ease-spring), opacity 220ms ease;
    opacity: 0;
    pointer-events: none;
    z-index: 99;
  }
  .mobile-menu.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mobile-link {
    display: block;
    padding: var(--space-3) 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-actions {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
    margin-top: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }
  .mobile-actions .btn {
    flex-shrink: 0;
  }
  .mobile-phone {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-brand-500);
    margin-right: auto;
  }
  .mobile-channels {
    display: inline-flex;
    gap: var(--space-2);
  }
  .ic-btn-mobile {
    background: rgba(37, 99, 235, 0.10);
  }

  @media (max-width: 960px) {
    .nav,
    .actions {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');

  let menuOpenAtY = 0;

  const isMenuOpen = () => menu?.classList.contains('is-open') ?? false;

  const toggle = (open?: boolean) => {
    if (!menu || !burger) return;
    const next = open ?? !menu.classList.contains('is-open');
    menu.classList.toggle('is-open', next);
    if (next) menu.removeAttribute('inert');
    else menu.setAttribute('inert', '');
    burger.setAttribute('aria-expanded', String(next));
    if (next) menuOpenAtY = window.scrollY;
  };

  const onScroll = () => {
    if (header) {
      if (window.scrollY > 30) header.classList.add('is-scrolled');
      else header.classList.remove('is-scrolled');
    }
    if (isMenuOpen() && Math.abs(window.scrollY - menuOpenAtY) > 20) {
      toggle(false);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Close menu when resizing past mobile breakpoint
  window.addEventListener('resize', () => {
    if (window.innerWidth > 960 && isMenuOpen()) toggle(false);
  });

  if (burger && menu) {
    burger.addEventListener('click', () => toggle());
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => toggle(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }
</script>
