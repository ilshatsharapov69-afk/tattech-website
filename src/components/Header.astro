---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: '#services', label: 'Услуги' },
  { href: '#programs', label: 'Программы 1С' },
  { href: '#cases', label: 'Кейсы' },
  { href: '#contacts', label: 'Контакты' },
];
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <a href={`${base}/`} class="logo" aria-label="T-Tech — на главную">
      <img src={`${base}/images/logo.png`} alt="T-Tech" width="40" height="40" />
      <span class="logo-text">T-Tech</span>
    </a>

    <nav class="nav" aria-label="Главное меню">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href="tel:+79520434277" class="phone">+7 952 043 4277</a>
      <a
        href="https://t.me/CyclesOfID"
        target="_blank"
        rel="noopener"
        class="btn btn-primary btn-sm"
        aria-label="Написать в Telegram"
      >
        <Icon name="telegram" size={16} />
        <span>Telegram</span>
      </a>
    </div>

    <button class="burger" aria-label="Открыть меню" aria-expanded="false" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Мобильное меню">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href} class="mobile-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mobile-actions">
      <a href="tel:+79520434277" class="mobile-phone">+7 952 043 4277</a>
      <a
        href="https://t.me/CyclesOfID"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
      >
        <Icon name="telegram" size={18} />
        <span>Написать в Telegram</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    transition: background-color 240ms ease, box-shadow 240ms ease, backdrop-filter 240ms ease;
  }
  .header.is-scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    box-shadow: var(--shadow-sm);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .logo img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }
  .logo-text {
    letter-spacing: -0.01em;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: var(--space-6);
  }
  .nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-soft);
    transition: color 200ms ease;
    padding: 6px 2px;
    position: relative;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 0;
    height: 2px;
    background: var(--color-brand-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease-spring);
  }
  .nav a:hover {
    color: var(--color-text);
  }
  .nav a:hover::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: var(--space-4);
  }
  .phone {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 200ms;
  }
  .phone:hover {
    color: var(--color-brand-500);
  }
  .btn-sm {
    padding: 10px 16px;
    font-size: 0.875rem;
  }
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    margin-left: auto;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 240ms var(--ease-spring), opacity 200ms ease;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: var(--space-8) var(--container-pad);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transform: translateY(-100%);
    transition: transform 320ms var(--ease-spring);
    pointer-events: none;
    z-index: 99;
  }
  .mobile-menu.is-open {
    transform: translateY(0);
    pointer-events: auto;
  }
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .mobile-link {
    display: block;
    padding: var(--space-4) 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .mobile-phone {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-brand-500);
  }

  @media (max-width: 960px) {
    .nav,
    .actions {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 30) header.classList.add('is-scrolled');
    else header.classList.remove('is-scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  if (burger && menu) {
    const toggle = (open?: boolean) => {
      const isOpen = open ?? !menu.classList.contains('is-open');
      menu.classList.toggle('is-open', isOpen);
      menu.setAttribute('aria-hidden', String(!isOpen));
      burger.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    };
    burger.addEventListener('click', () => toggle());
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => toggle(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }
</script>
